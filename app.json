{
  "expo": {
    "name": "SchoolTransport Parent",
    "slug": "school-transport-parent",
    "version": "2.0.0",
    "sdkVersion": "55.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carribu.parent",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.carribu.parent",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBJmKq7c0Kh-CcseZYlBPLeqbfiqWZdYO4"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-location",
      ["expo-build-properties", {
        "android": {
          "enableProguardInReleaseBuilds": true,
          "enableShrinkResourcesInReleaseBuilds": true
        }
      }]
    ],
    "owner": "firstbodis-organization",
    "extra": {
      "eas": {
        "projectId": "5a7e2785-c184-4c0f-9647-7adaeac12da8"
      }
    }
  }
}
